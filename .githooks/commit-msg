#!/bin/sh

# commit message 首行必须使用项目提交模板。
# 模板让 feature、变更类型和不兼容标识在提交历史中可检索。

msg_file="$1"
first_line=$(head -n 1 "$msg_file" | tr -d '\r')

# 跳过 merge commit 和 fixup commit
case "$first_line" in
  Merge\ *|fixup\ !*) exit 0 ;;
esac

if [ -z "$first_line" ]; then
  echo "错误：commit message 首行不能为空。"
  exit 1
fi

# 检查首行是否包含 CJK 字符（中文）
has_cjk=$(node -e "process.stdout.write(/[\u4e00-\u9fff]/.test(process.argv[1]) ? 'yes' : 'no')" "$first_line")
if [ "$has_cjk" != "yes" ]; then
  echo "错误：commit message 首行必须包含中文字符。"
  echo "当前首行: $first_line"
  exit 1
fi

is_template_valid=$(node -e "
const title = process.argv[1];
const id = '(\\\\d{10}|\\\\d{8}[a-kmnp-z][2-9a-kmnp-z]{3,9})';
const cjk = '[\\\\u4e00-\\\\u9fff]';
// F：必须带变更类型；R：类型可省略（与 CI PR 标题规则及历史 R 提交一致）
// 类型白名单与 commit-convention.md Type Tags 对齐（补录 Design/Refactor，#427）
const types = '(Feature Update|BugFix|New Feature|Refactor|Design)';
const f = new RegExp('^\\\\[F' + id + '\\\\]\\\\[[a-z]+\\\\]\\\\[' + types + '\\\\](\\\\[Incompatible\\\\])?\\\\s+.+' + cjk + '.*$');
const r = new RegExp('^\\\\[R' + id + '\\\\]\\\\[[a-z]+\\\\](\\\\[' + types + '\\\\](\\\\[Incompatible\\\\])?)?\\\\s+.+' + cjk + '.*$');
process.stdout.write((f.test(title) || r.test(title)) ? 'yes' : 'no');
" "$first_line")
if [ "$is_template_valid" != "yes" ]; then
  echo "错误：commit message 首行必须使用模板："
  echo "[F|YYYYMMDDNN|YYYYMMDDxNNN][module][Feature Update|BugFix|New Feature|Refactor|Design][Incompatible] 中文标题"
  echo "或 [R...][module] 中文标题（R=research，类型字段可省略）"
  echo "说明：ID 前缀 F=feature/bugfix（须带变更类型），R=research。[Incompatible] 仅在存在不兼容更新时出现。"
  echo "xxxx 首位必须是字母（a-k, m-n, p-z，排除 l/o），后 3-9 位为 2-9 数字或 a-k, m-n, p-z 字母（排除 l/o/0/1），以区分日期部分（4-10 位后缀，与 docs/README 及 CI PR 标题规则对齐）。"
  echo "module 为小写字母格式（如 agent、web、memory 等功能区域标签，不允许连字符）"
  echo "当前首行: $first_line"
  exit 1
fi

# F20260825m422a: 日期语义校验——F 类特性 ID 日期与系统日期偏差 > 2 天则拒绝（#422）
# R 类 ID 跳过：R 类日期是研究文档创建日（frontmatter 锚点），跨天迭代追加 commit 时日期必然不同
if ! echo "$first_line" | grep -q '^\[F'; then
  exit 0
fi
date_check=$(node -e "
const title = process.argv[1];
const match = title.match(/^\\[F([0-9]{8})/);
if (!match) { process.stdout.write('skip'); process.exit(0); }
const idDate = match[1];
// 三层时区口径统一为 Asia/Shanghai：与 identity-builder 注入层一致
const now = new Date();
const shNow = new Date(now.toLocaleString('en-US', { timeZone: 'Asia/Shanghai' }));
const y = shNow.getFullYear();
const m = String(shNow.getMonth() + 1).padStart(2, '0');
const d = String(shNow.getDate()).padStart(2, '0');
const today = y + m + d;
const idD = new Date(parseInt(idDate.slice(0,4)), parseInt(idDate.slice(4,6))-1, parseInt(idDate.slice(6,8)));
const todayD = new Date(parseInt(today.slice(0,4)), parseInt(today.slice(4,6))-1, parseInt(today.slice(6,8)));
const diffDays = Math.round(Math.abs(idD.getTime() - todayD.getTime()) / 86400000);
if (diffDays > 2) {
  process.stdout.write('fail:' + idDate + ':' + today + ':' + diffDays);
} else {
  process.stdout.write('ok');
}
" "$first_line")

case "$date_check" in
  fail:*)
    id_date=$(echo "$date_check" | cut -d: -f2)
    sys_date=$(echo "$date_check" | cut -d: -f3)
    days=$(echo "$date_check" | cut -d: -f4)
    echo "错误：特性 ID 日期与系统日期不符（偏差 ${days} 天）。"
    echo "  ID 日期: ${id_date}  系统日期: ${sys_date}"
    echo "请跑 date 确认今天日期，修正 F 类特性 ID 后重新提交。"
    exit 1
    ;;
esac
