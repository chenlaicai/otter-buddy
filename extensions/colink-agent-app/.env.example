# CoLink App 身份与连接（由 @colink/app-sdk 直接读取，创建运行时即校验）
COLINK_APP_ID=replace-with-app-id
COLINK_APP_INSTANCE_ID=replace-with-deployment-id
COLINK_CLIENT_ID=replace-with-client-id
COLINK_CLIENT_SECRET=replace-with-client-secret
COLINK_SIGNING_SECRET=replace-with-32-plus-character-signing-secret
COLINK_ISSUER=https://colink.example.com
COLINK_ALLOW_INSECURE_ISSUER=false
# App 自身页面的可信 origin；manifest 声明了 app 渲染视图，SDK 需要它启用页面会话。
COLINK_APP_ORIGIN=https://app.example.com
# 宿主 CoLink 主站 origin；与 issuer 同源时留空。
COLINK_HOST_ORIGIN=
# SDK 状态与密钥：默认 ./.colink/state.enc 与其旁的 .key，目录需持久化、备份且仅服务账号可读。
COLINK_STATE_FILE=/var/lib/colink-agent-app/state.enc
# 可选：显式提供 64 位十六进制密钥，覆盖自动生成的 .key。
# COLINK_CREDENTIAL_KEY=
COLINK_BIND_HOST=127.0.0.1
COLINK_PORT=31130

# 本扩展自己的配置
# 中枢地址：同机部署用 http://127.0.0.1:3000 即可；走公网域名 / 反代（https://otter.xxx）时
# 必须同时给 OTTER_SERVICE_TOKEN——中枢的声明式身份头只对本机直连生效，跨反代会被 401。
OTTER_BASE_URL=http://127.0.0.1:3000
# 中枢服务令牌：与中枢侧 config.yaml 的 auth.serviceToken（或 env OTTER_SERVICE_TOKEN）同值，
# 至少 16 字符（建议 openssl rand -base64 32）。填了它本扩展改用 Authorization: Bearer，
# 于是公网域名 / 反代同样可用；不填则退回声明式身份头（只有本机直连能过）。
# OTTER_SERVICE_TOKEN=
DATA_DIR=/var/lib/colink-agent-app
# 仅回环监听的 Otter MCP 代理；保持稳定，勿暴露到安全组/公网。
COLINK_MCP_PORT=31131
# MCP bearer 派生密钥（>=32 字符）。必须跨部署保持稳定：Otter 的 mcp-external 守卫
# 要求同一 server 的 bearer 不变，换值会让已在用的 workspace 写入 409。
COLINK_MCP_SECRET=replace-with-32-plus-character-mcp-secret
