COLINK_APP_ID=replace-with-app-id
COLINK_APP_INSTANCE_ID=replace-with-deployment-id
COLINK_CLIENT_ID=replace-with-client-id
COLINK_CLIENT_SECRET=replace-with-client-secret
COLINK_SIGNING_SECRET=replace-with-signing-secret
COLINK_ISSUER=https://colink.example.com
COLINK_API_BASE=https://colink.example.com/api/v1
COLINK_CREDENTIAL_KEY=replace-with-64-hex-character-store-key
COLINK_ALLOW_INSECURE_ISSUER=false
# 宿主页面 web origin（iframe postMessage 握手校验）；App 与宿主同域时可留空，默认回退到 COLINK_ISSUER。
COLINK_HOST_ORIGIN=
OTTER_BASE_URL=http://127.0.0.1:3000
DATA_DIR=/var/lib/colink-agent-app
HOST=127.0.0.1
PORT=31130
# 仅回环监听的 Otter MCP 代理；保持稳定，勿暴露到安全组/公网。
COLINK_MCP_PORT=31131
