# Copy to app.env for manual startup. Replace every placeholder; never commit real secrets.
# Playground run generates isolated configuration automatically; do not use this file there.

# Identity and credentials from CoLink application registration.
COLINK_APP_ID=<App ID>
COLINK_APP_INSTANCE_ID=<Deployment ID>
COLINK_CLIENT_ID=<Client ID>
COLINK_CLIENT_SECRET=<Client Secret>
COLINK_SIGNING_SECRET=<Signing Secret>
COLINK_ISSUER=https://colink.example.com

# State defaults to ./.colink/state.enc; its persistent key is state.enc.key.
# Paths are relative to the process working directory. Add .colink/ to .gitignore.
# Persist/backup this directory; separate App processes need separate state files.
# Optional override: COLINK_STATE_FILE=/persistent/app/state.enc

# Required when the Manifest declares an app-rendered view.
COLINK_APP_ORIGIN=https://app.example.com

# Captured at runtime creation and used by serveCoLinkRuntime unless explicitly overridden.
# Reverse proxies/containers: the listener is independent of the public origins above.
COLINK_BIND_HOST=127.0.0.1
COLINK_PORT=8080

# Optional settings and overrides: see for-ai-sdk.md, chapter 4, in the For AI docs ZIP.
