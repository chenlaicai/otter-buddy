{
  "name": "otter-buddy",
  "version": "0.1.0",
  "description": "Otter Buddy - An Agentic System with Chat as Substrate",
  "main": "dist/src/main.js",
  "scripts": {
    "prepare": "node scripts/ensure-hooks.mjs",
    "hooks:check": "node scripts/ensure-hooks.mjs --check",
    "hooks:fix": "node scripts/ensure-hooks.mjs",
    "health:report": "node scripts/health-report.mjs",
    "weixin:login": "npm run build --silent && node scripts/weixin-login.mjs",
    "health:backfill": "node scripts/health-backfill.mjs",
    "docs:advance": "node scripts/docs-advance.mjs",
    "build": "npm run lint && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npx tsc && npx tsc-alias -f && (node scripts/download-bge-m3.mjs || echo \"[bge-m3] 模型下载失败，启动时将重试或降级 FTS-only\")",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:docs": "node scripts/lint-docs.mjs",
    "pretest": "npm run lint",
    "test": "vitest run",
    "check": "npm run build",
    "download:bge-m3": "node scripts/download-bge-m3.mjs",
    "start": "npm run build && node dist/src/main.js",
    "test:capability": "npm run build && vitest run --config vitest.capability.config.ts",
    "test:capability:only": "vitest run --config vitest.capability.config.ts",
    "test:all": "npm test && npm run test:capability",
    "lint:capability": "node scripts/lint-capability-docs.mjs",
    "lint:tests": "node scripts/lint-tests.mjs",
    "lint:skills": "node scripts/lint-skills.mjs",
    "lint:tool-manifest": "node scripts/lint-tool-manifest.mjs",
    "lint:intent": "node scripts/lint-intent.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@hono/node-server": "^2.1.1",
    "@huggingface/transformers": "^4.2.0",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@node-rs/jieba": "^2.0.2",
    "@types/busboy": "^1.5.4",
    "better-sqlite3": "^13.0.3",
    "busboy": "^1.6.0",
    "croner": "^10.0.1",
    "hono": "^4.13.3",
    "js-yaml": "^5.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "silk-wasm": "^3.7.1",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@huggingface/transformers": {
      "onnxruntime-node": "1.23.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsc-alias": "^1.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "onnxruntime-node@1.23.2": true,
    "sharp@0.34.5": true
  }
}
