{
  "name": "otter-buddy",
  "version": "0.1.0",
  "description": "Otter Buddy - An Agentic System with Chat as Substrate",
  "main": "dist/src/main.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "npm run lint && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npx tsc && npx tsc-alias -f && (node scripts/download-bge-m3.mjs || echo \"[bge-m3] 模型下载失败，启动时将重试或降级 FTS-only\")",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:docs": "node scripts/lint-docs.mjs",
    "pretest": "npm run lint",
    "test": "vitest run",
    "check": "npm run build",
    "download:bge-m3": "node scripts/download-bge-m3.mjs",
    "start": "npm run build && node dist/src/main.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-ai": "^0.81.1",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@hono/node-server": "^2.0.11",
    "@huggingface/transformers": "^4.2.0",
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "better-sqlite3": "^13.0.1",
    "croner": "^10.0.1",
    "hono": "^4.12.31",
    "js-yaml": "^5.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "sqlite-vec": "^0.1.6",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@huggingface/transformers": {
      "onnxruntime-node": "1.23.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "tsc-alias": "^1.9.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "onnxruntime-node@1.23.2": true,
    "sharp@0.34.5": true
  }
}
