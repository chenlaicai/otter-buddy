{
  "schemaVersion": 2,
  "defaultType": "big",
  "toolExposure": {
    "add_terminology": "deferred",
    "delete_context": "deferred",
    "unlink_memory": "deferred",
    "update_artifact_status": "deferred",
    "create_scheduled_task": "deferred",
    "query_dispatch_ledger": "deferred",
    "list_rhi_signals": "deferred",
    "triage_signal": "deferred",
    "unhalt_otter": "deferred",
    "halt_otter": "deferred",
    "resolve_signal": "deferred",
    "merge_pr": "deferred",
    "restart_otter": "deferred",
    "workspace_info": "deferred",
    "get_html_card_contract": "deferred"
  },
  "capabilityBlocks": {
    "memory": {
      "description": "记忆检索与管理",
      "tools": [
        "search_memory",
        "create_linked_resource",
        "get_memory_detail",
        "link_memory",
        "get_related",
        "unlink_memory",
        "sync_docs"
      ]
    },
    "conversation": {
      "description": "对话历史查询",
      "tools": [
        "get_message",
        "list_messages",
        "search_messages"
      ]
    },
    "context": {
      "description": "上下文管理",
      "tools": [
        "get_context",
        "set_context",
        "delete_context"
      ]
    },
    "terminology": {
      "description": "术语库管理",
      "tools": [
        "search_terminology",
        "add_terminology"
      ]
    },
    "artifacts": {
      "description": "产物生命周期管理",
      "tools": [
        "list_artifacts",
        "update_artifact_status"
      ]
    },
    "system": {
      "description": "系统工具（参与者/卡片/定时/自愈/信号台账查询/待办板）",
      "tools": [
        "get_active_participants",
        "get_html_card_contract",
        "create_scheduled_task",
        "manage_healing_events",
        "query_signals",
        "list_matters",
        "transition_matter"
      ]
    },
    "orchestration": {
      "description": "编排/裁决工具（halt 停獭、unhalt 解除、signal 裁决）——仅 big 型引用，small 不得持有",
      "tools": [
        "halt_otter",
        "unhalt_otter",
        "resolve_signal"
      ]
    },
    "workspace": {
      "description": "工作区文件操作",
      "tools": [
        "workspace_info",
        "workspace_list",
        "workspace_read",
        "workspace_write"
      ]
    }
  },
  "types": {
    "big": {
      "description": "大獭 - 全功能",
      "tools": "*"
    },
    "small": {
      "description": "小獭 - 去除 otter 管理类",
      "groups": [
        "memory",
        "conversation",
        "context",
        "terminology",
        "artifacts",
        "system",
        "workspace"
      ],
      "tools": [
        "speak",
        "yield",
        "restart_otter"
      ]
    }
  }
}