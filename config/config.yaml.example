# Otter Buddy 配置文件
# 复制本文件为 config.yaml 并填入实际值
# config.yaml 已加入 .gitignore，不会被提交到代码仓库

# === 服务配置 ===
server:
  # HTTP 服务监听端口（默认 3000）
  port: 3000

# === 数据库配置 ===
database:
  # SQLite 数据库文件路径（默认当前目录下 otter-buddy.db）
  path: ./otter-buddy.db
  # WAL 模式，提升并发读取性能（默认 true）
  walMode: true
  # 启用外键约束（默认 true）
  foreignKeys: true

# === LLM 配置（必填）===
llm:
  # LLM 提供商，可选值：openai / anthropic（必填）
  provider: openai
  # 模型标识符，例如 gpt-4o、claude-sonnet-4-20250514（必填）
  model: gpt-4o
  # API Key（可选）
  # 优先级：此配置值 > 存储的凭据 > 环境变量（OPENAI_API_KEY 或 ANTHROPIC_API_KEY）
  # 方式一：直接填入 API Key
  # apiKey: "sk-your-actual-key"
  # 方式二：不配置此项，自动从环境变量读取
  # 自定义 API 基础地址（可选）
  # 用于代理或私有部署，例如 https://your-proxy.com/v1
  # 不配置则使用各提供商的默认地址
  # apiBaseUrl: "https://your-proxy.com/v1"

# === 记忆系统配置 ===
memory:
  # RRF（Reciprocal Rank Fusion）的 k 参数（默认 60）
  # 用于合并不同检索源（FTS5 vs 向量搜索）的排序结果
  # 值越大，排名分数曲线越平缓
  rrfK: 60
  # 记忆权重衰减半衰期，单位：天（默认 7）
  # 记忆每经过这么多天，相关性权重减半
  weightHalfLifeDays: 7
  # 用户标记记忆的加权倍数（默认 2.0）
  # 用户主动标记的记忆在检索排名中获得此倍数加成
  userFlagMultiplier: 2.0
  # 检索频次加成系数（默认 0.1）
  # 每次记忆被检索，其分数增加此值，实现"越用越强"的效果
  frequencyBoostFactor: 0.1

# === Embedding 配置 ===
embedding:
  # 向量维度（默认 1024）
  # 必须与 Embedding 模型的输出维度一致
  dimensions: 1024
  # HuggingFace 模型标识符或本地路径（默认 Xenova/bge-m3）
  # 默认模型为多语言模型，输出 1024 维向量
  modelPath: Xenova/bge-m3

# === 熔断器配置 ===
circuitBreaker:
  # 单次 Agent 执行允许的最大工具调用总数（默认 40）
  # 超出后熔断器触发，终止执行
  maxToolCalls: 40
  # 允许的最大连续相同工具调用次数（默认 5）
  # 连续相同调用达到此次数，触发熔断
  maxConsecutiveIdentical: 5
  # 单次工具调用最大执行时间，单位：毫秒（默认 600000，即 10 分钟）
  maxPerEventTimeMs: 600000
  # 工具调用数警告阈值（默认 20）
  # 达到此次数时发出警告，早于熔断触发
  warningThreshold: 20
  # 滑动窗口大小，用于检测重复模式（默认 6）
  slidingWindowSize: 6
  # 滑动窗口内重复次数触发阈值（默认 3）
  # 在 slidingWindowSize 次调用中，相同模式出现此次数则触发熔断
  slidingWindowRepeat: 3
  # steer 警告后容忍的继续触发次数（默认 5）
  # 首次触发规则注入 steer 警告；之后每再触发一次记 1 次，超过此次数则强制中断
  # 出现任何一次正常调用（allow）即清零解除
  maxRepeatAfterWarning: 5
  # Token 使用量警告阈值（默认 50000）
  # 达到此阈值时发出高上下文/Token 使用量警告
  tokenWarningThreshold: 50000
  # 每条用户消息允许的发言链接力最大跳数（默认 20）
  # 安全阀：防 agent 互相接力失控；合法多轮协作不应触达
  # 注意：按"每条用户消息"计数，用户发新消息后重置；并行扇出不额外计跳
  # 触顶时系统向对话注入提示消息，发言石交还用户
  maxChainDepth: 20
  # === 文本生成退化检测（OutputGuard）===
  outputGuard:
    # 是否启用退化检测（默认 true）
    enabled: true
    # 片段长度（字符），用于检测重复模式（默认 100）
    segmentLength: 100
    # 相同片段重复多少次触发 abort（默认 50）
    maxRepeatedSegments: 50
    # 每累积多少个片段检查一次重复（默认 20）
    checkInterval: 20
  # 流式超时（毫秒），连续无新内容则 abort（默认 120000，即 2 分钟）
  streamingTimeoutMs: 120000

# === 飞书集成配置（可选）===
# 配置后启用飞书 Webhook 接入，支持 IM 大厅功能
# 飞书群可通过命令与系统对话交互
# feishu:
#   # 飞书应用 App ID（必填，从飞书开放平台获取）
#   appId: "cli_xxxxxxxxxxxxxxxx"
#   # 飞书应用 App Secret（必填，从飞书开放平台获取）
#   appSecret: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#   # 事件加密密钥（可选，用于解密飞书加密事件）
#   encryptKey: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# === 飞书集成使用说明 ===
# 1. 在飞书开放平台创建自建应用
# 2. 启用"机器人"能力
# 3. 订阅事件：im.message.receive_v1
# 4. 配置请求地址：https://your-domain.com/feishu/webhook
# 5. 获取 App ID 和 App Secret，填入上方配置
# 6. 在 Web 端创建 Connection，绑定飞书群
# 7. 在飞书群中使用命令：
#    /list - 查看所有活跃对话
#    /in <对话ID> - 进入指定对话
#    /history - 查看当前对话历史消息
#    /help - 显示帮助信息
