# Otter Buddy 配置文件
# 复制本文件为 config.yaml 并填入实际值
# config.yaml 已加入 .gitignore，不会被提交到代码仓库

# === 服务配置 ===
server:
  # HTTP 服务监听端口（默认 3000）
  port: 3000

# === 数据库配置 ===
database:
  # SQLite 数据库文件路径（默认当前目录下 otter-buddy.db）
  path: ./otter-buddy.db
  # WAL 模式，提升并发读取性能（默认 true）
  walMode: true
  # 启用外键约束（默认 true）
  foreignKeys: true

# === LLM 配置（必填）===
llm:
  # 默认模型的 alias（缺省时取 models[] 第一条）
  default: "default"
  # 模型列表（唯一配置方式；单模型即一条 models[] 条目）
  # 每个模型有唯一 alias，大獭创建小獭时可通过 modelAlias 选择
  models:
    - alias: "default"
      provider: openai
      model: gpt-4o
      # API Key（可选）
      # 优先级：此配置值 > 存储的凭据 > 环境变量（OPENAI_API_KEY 或 ANTHROPIC_API_KEY）
      # apiKey: "sk-your-actual-key"
      # 自定义 API 基础地址（可选）
      # apiBaseUrl: "https://your-proxy.com/v1"
      description: "平衡型模型，适合日常对话和编码"
      strengths: ["强推理", "代码能力优秀", "长上下文"]
      weaknesses: ["价格较高"]
      contextWindow: 128000
      # 模型输入能力（可选，多模态支持）
      # 显式声明时覆盖 provider 模板默认值；支持图片的模型声明 ["text", "image"]
      # input: ["text", "image"]

    # 示例：添加第二个模型
    # - alias: "fast"
    #   provider: anthropic
    #   model: claude-haiku-4-20250514
    #   apiKey: "sk-your-key"
    #   description: "轻量快速模型，适合简单任务"
    #   strengths: ["极快", "便宜"]
    #   weaknesses: ["复杂推理有限"]
    #   contextWindow: 200000

# === 记忆系统配置 ===
memory:
  # RRF（Reciprocal Rank Fusion）的 k 参数（默认 60）
  # 用于合并不同检索源（FTS5 vs 向量搜索）的排序结果
  # 值越大，排名分数曲线越平缓
  rrfK: 60
  # 记忆权重衰减半衰期，单位：天（默认 7）
  # 记忆每经过这么多天，相关性权重减半
  weightHalfLifeDays: 7
  # 用户标记记忆的加权倍数（默认 2.0）
  # 用户主动标记的记忆在检索排名中获得此倍数加成
  userFlagMultiplier: 2.0
  # 检索频次加成系数（默认 0.1）
  # 每次记忆被检索，其分数增加此值，实现"越用越强"的效果
  frequencyBoostFactor: 0.1

# === Embedding 配置 ===
embedding:
  # 向量维度（默认 1024）
  # 必须与 Embedding 模型的输出维度一致
  dimensions: 1024
  # 模型标识（默认 Xenova/bge-m3，多语言模型，输出 1024 维向量）
  # - 本地模式（推荐）：配合 localModelPath，modelPath 为其下子目录名（如 bge-m3）
  # - 远程模式：不设 localModelPath，modelPath 为 HuggingFace repo id（如 Xenova/bge-m3）
  #   远程下载支持镜像：设置环境变量 HF_ENDPOINT=https://hf-mirror.com
  modelPath: bge-m3
  # 本地模型根目录（相对仓库根或绝对路径）。
  # 设置后启用本地加载、禁用远程下载——避免每次启动联网拉模型。
  # 目录结构示例（modelPath=bge-m3）：
  #   <localModelPath>/bge-m3/
  #     ├─ config.json
  #     ├─ tokenizer.json
  #     └─ onnx/{model.onnx, model.onnx_data}
  localModelPath: ./models

# === 熔断器配置 ===
circuitBreaker:
  # 允许的最大连续相同工具调用次数（默认 5）
  # 连续相同调用达到此次数，触发熔断
  maxConsecutiveIdentical: 5
  # 单次工具调用最大执行时间，单位：毫秒（默认 600000，即 10 分钟）
  maxPerEventTimeMs: 600000
  # 滑动窗口大小，用于检测重复模式（默认 6）
  slidingWindowSize: 6
  # 滑动窗口内重复次数触发阈值（默认 3）
  # 在 slidingWindowSize 次调用中，相同模式出现此次数则触发熔断
  slidingWindowRepeat: 3
  # steer 警告后容忍的继续触发次数（默认 5）
  # 首次触发规则注入 steer 警告；之后每再触发一次记 1 次，超过此次数则强制中断
  # 出现任何一次正常调用（allow）即清零解除
  maxRepeatAfterWarning: 5
  # Token 使用量警告阈值（默认 50000）
  # 达到此阈值时发出高上下文/Token 使用量警告
  tokenWarningThreshold: 50000
  # 每条用户消息允许的发言链接力最大跳数（默认 20）
  # 安全阀：防 agent 互相接力失控；合法多轮协作不应触达
  # 注意：按"每条用户消息"计数，用户发新消息后重置；并行扇出不额外计跳
  # 触顶时系统向对话注入提示消息，发言石交还用户
  maxChainDepth: 20
  # 熔断创建的 session 年龄窗口阈值（默认 7200000，即 2 小时，单位毫秒）
  # 超过此时间视为「session 已证明健康」，后续退化重新给一次熔断机会
  # 参见 F20260831cbkw
  healthySessionThresholdMs: 7200000
  # === 文本生成退化检测（OutputGuard，F20260804dglp）===
  outputGuard:
    # 是否启用退化检测（默认 true）
    enabled: true
    # 退化检测器参数（双机制：非对齐滑窗精确重复 + distinct-ratio 近似重复）
    detector:
      # 滑窗/分段长度（字符）（默认 100）
      windowLength: 100
      # 机制 A：同一窗口出现多少次触发 abort（默认 50）
      # 失控循环的单窗口计数 ≈ 块长/周期；良性"整段复述两遍"计数=2，不误伤
      maxWindowRepeats: 50
      # 机制 B：块最小长度（字符），低于此不做 ratio 判定（默认 5000）
      minBlockLength: 5000
      # 机制 B：distinct/total ≤ 此值判退化（默认 0.3；合法块实测最低 0.838）
      distinctRatioThreshold: 0.3
  # 流式超时（毫秒），连续无新内容则 abort（默认 120000，即 2 分钟）
  streamingTimeoutMs: 120000
  # 首字节超时（毫秒），prompt 发出后无任何 delta 则 abort（默认 300000，即 5 分钟）
  # 覆盖排队 + prefill 静默期；大上下文 TTFT 实测 ~70s，留足余量
  firstByteTimeoutMs: 300000

# === 飞书集成配置（可选）===
# 配置后启用飞书长连接接入，支持 IM 大厅功能
# 飞书群可通过命令与系统对话交互
# feishu:
#   # 飞书应用 App ID（必填，从飞书开放平台获取）
#   appId: "cli_xxxxxxxxxxxxxxxx"
#   # 飞书应用 App Secret（必填，从飞书开放平台获取）
#   appSecret: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#   # 事件加密密钥（可选，用于解密飞书加密事件）
#   encryptKey: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#   # 搭档（本实例主人）的飞书 open_id（F20260826fpbd）
#   # 搭档身份静态锚定：海獭的「搭档」始终是这个人，不随消息发送者变化；
#   # 未配置时降级为动态推断（当前说话者视为搭档）
#   # 获取方式见 docs/user-guide/feishu-setup.md「搭档身份绑定」
#   partnerOpenId: "ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# === 飞书集成使用说明 ===
# 详细步骤见 docs/user-guide/feishu-setup.md
# 1. 在飞书开放平台创建自建应用，启用"机器人"能力
# 2. 订阅事件：im.message.receive_v1（长连接方式）
# 3. 开通权限（权限管理页搜索开通并发布版本）：
#    - im:message（必选，接收单聊+群聊消息事件推送；只开 p2p 子集会导致群聊不通）
#    - im:message:send_as_bot（必选，发送消息；与 im:message 任开其一可发送，建议都开）
#    - contact:contact.base:readonly（推荐，群聊多人识别：发送者 open_id → 姓名；注意不是 contact:user.base:readonly，该名不存在）
# 4. 获取 App ID 和 App Secret，填入上方配置
# 5. 在 Web 端创建 Connection，绑定飞书群
# 6. 在飞书群中使用命令：
#    /list - 查看所有活跃对话
#    /in <对话ID> - 进入指定对话
#    /out - 退出当前对话
#    /history - 查看当前对话历史消息
#    /help - 显示帮助信息

# === 招聘桥接 Inbound 配置（可选）===
# 配置后启用 Chrome 扩展（boss-zhipin-bridge）向 otter-buddy 推送 BOSS 直聘消息
# apiKey 是扩展和服务端共享的密钥，扩展端 options 页要填同样的值
# 生成建议：openssl rand -hex 32
# inbound:
#   recruiting:
#     apiKey: "生成一个随机长字符串作为共享密钥"

# === Web 端配置（可选）===
# 用于 IM 信道（如飞书）html-card 占位符拼接跳转链接
# 不配置时，飞书侧 html-card 占位符只显示标题、不带可点击链接
# web:
#   baseUrl: "https://your-otter-instance.example.com"

# === 附件配置（可选，多模态支持）===
# 缺省全部用内置默认值；存储根目录随 data/ 一起备份
# attachments:
#   # 存储根目录（默认 ./data/attachments）
#   storageRoot: "./data/attachments"
#   # 图片大小上限（字节，默认 10MB）
#   maxImageBytes: 10485760
#   # 文档大小上限（字节，默认 20MB）
#   maxDocumentBytes: 20971520
